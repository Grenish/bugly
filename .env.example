# Database
# Used by packages/database/prisma.config.ts and packages/database/src/client.ts
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Sentry
# Leave empty in your real .env if you want to disable Sentry event delivery locally.
SENTRY_DSN="https://c5d8c227edf2f2697d0a859fa8dfc7e9@o4510107642888193.ingest.us.sentry.io/4511497881518080"

# Optional: environment name shown in Sentry, e.g. development, preview, production.
NODE_ENV="development"

# Optional: release/version shown in Sentry, e.g. bugly@0.1.0 or a git SHA.
SENTRY_RELEASE=""

# Matches your previous inline config: tracesSampleRate: 1.0
SENTRY_TRACES_SAMPLE_RATE="1.0"

# Matches your previous inline config: enableLogs: true
SENTRY_ENABLE_LOGS="true"

# Matches your previous inline config: sendDefaultPii: true
# Set this to false if you want safer privacy defaults.
SENTRY_SEND_DEFAULT_PII="false"

# Optional: enables the /debug-sentry route when set to true.
# Keep false unless you are intentionally testing Sentry.
SENTRY_DEBUG="false"
